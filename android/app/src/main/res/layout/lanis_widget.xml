<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="16dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="LANIS" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.1" android:maxLines="1" />
        <ImageButton android:id="@+id/widget_refresh" android:layout_width="32dp" android:layout_height="32dp" android:padding="10dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_refresh" android:contentDescription="@string/widget_refresh" />
    </LinearLayout>
    <TextView android:id="@+id/widget_headline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Dein Schultag beginnt hier." android:textSize="19sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
    <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp" />
    <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Zum Anmelden tippen" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
