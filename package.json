{
  "name": "lanis-ui",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "@khmyznikov/pwa-install": "^0.6.3",
    "axios": "^1.6.2",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.1.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "puppeteer-core": "^25.1.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.3.5",
    "to-ico": "^1.0.1",
    "typescript": "^5.2.2",
    "vite": "^7.3.6",
    "wrangler": "4.151.1"
  },
  "scripts": {
    "predev": "npm run images:optimize",
    "dev": "vite",
    "images:optimize": "node scripts/optimize-landing-images.mjs",
    "prebuild": "npm run images:optimize",
    "test": "node scripts/test-video-room.cjs && node scripts/test-safe-http-url.cjs && node scripts/test-download-filename.cjs && node scripts/test-account-data.cjs && node scripts/test-timetable-colours.cjs && node scripts/test-timetable-exams.cjs && node scripts/test-timetable-refresh.cjs && node --test scripts/optimize-landing-images.test.mjs scripts/cloudflare/*.test.cjs",
    "build": "tsc && vite build",
    "postbuild": "node scripts/prerender.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
