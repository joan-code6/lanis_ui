{
  "name": "lanis-ui",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@heroicons/react": "^2.0.18",
    "@khmyznikov/pwa-install": "^0.6.3",
    "axios": "^1.6.2",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.20.5",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.1.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "puppeteer": "^25.1.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.3.5",
    "to-ico": "^1.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.2.2",
    "vite": "^7.3.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "postbuild": "node scripts/prerender.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "android:assets": "tsc --noEmit && vite build --mode android",
    "android:sync": "npm run android:assets && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "android:apk": "npm run android:sync && node scripts/android-build.mjs apk",
    "android:bundle": "npm run android:sync && node scripts/android-build.mjs bundle",
    "test:android": "tsx --test scripts/android.test.ts && node scripts/test-native-auth-storage.cjs",
    "test:account-data": "node scripts/test-account-data.cjs",
    "android:verify": "npm run android:sync && node scripts/android-build.mjs verify"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
